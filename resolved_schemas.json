  "JobTarget": {
    "description": "Configuración del puesto objetivo para personalización del CV.",
    "properties": {
      "titulo": {
        "description": "Título del puesto al que se postula (ej: 'Jefe de Operaciones')",
        "type": "string"
      },
      "industria": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Industria o sector (ej: 'Minería', 'Construcción', 'Logística')"
      },
      "seniority": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "Sin especificar",
        "description": "Nivel de seniority: 'Entry', 'Junior', 'Mid', 'Senior', 'Lead', 'Manager'"
      },
      "keywords_adicionales": {
        "description": "Palabras clave adicionales del sector a incluir",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "tono": {
        "default": "profesional",
        "description": "Tono del CV: 'profesional', 'ejecutivo', 'técnico', 'creativo', 'minero-industrial'",
        "type": "string"
      },
      "idioma": {
        "default": "es",
        "description": "Idioma: 'es' (español), 'en' (inglés), 'both' (bilingüe)",
        "type": "string"
      }
    },
    "required": [
      "titulo"
    ],
    "type": "object",
    "additionalProperties": false
  },
