        "description": "Perfil profesional optimizado por IA para el puesto objetivo"
      },
      "experiencia_laboral": {
        "description": "Lista de experiencias laborales en orden cronológico inverso",
        "items": {
          "description": "Experiencia laboral individual.",
          "properties": {
            "puesto": {
              "description": "Título del cargo o puesto",
              "type": "string"
            },
            "empresa": {
              "description": "Nombre de la empresa empleadora",
              "type": "string"
            },
            "fechas": {
              "description": "Período (ej: 'ene. 2024 – sep. 2025')",
              "type": "string"
            },
            "logros": {
              "description": "Lista de logros o responsabilidades (originales)",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "logros_mejorados": {
              "description": "Logros mejorados por IA con métricas cuantificables",
