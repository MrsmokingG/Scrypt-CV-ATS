                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "puesto",
            "empresa",
            "fechas"
          ],
          "type": "object",
          "additionalProperties": false
        },
        "type": "array"
      },
      "educacion": {
        "description": "Lista de formación académica y cursos",
        "items": {
          "description": "Registro educativo o formación.",
          "properties": {
            "titulo": {
              "description": "Título, grado o nombre del curso",
              "type": "string"
            },
            "institucion": {
              "description": "Institución educativa o entidad",
              "type": "string"
            },
            "fechas": {
              "description": "Año o período de estudio",
              "type": "string"
            }
          },
          "required": [
            "titulo",
            "institucion",
            "fechas"
          ],
          "type": "object",
          "additionalProperties": false
        },
        "type": "array"
      },
      "habilidades": {
        "description": "Lista completa de habilidades",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "habilidades_mejoradas": {
        "description": "Habilidades categorizadas y priorizadas por IA",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
